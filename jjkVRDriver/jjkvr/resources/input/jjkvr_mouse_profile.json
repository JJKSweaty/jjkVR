{
  "jsonid": "input_profile",
  "controller_type": "jjkvr_mouse",
  "compatibility_mode_controller_type": "oculus_touch",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "jjkvr",
  "driver_name": "jjkvr",
  "input_bindingui_mode": "controller_handed",
  "should_show_binding_errors": true,
  "input_source": {
    "/input/trigger": {
      "type": "trigger",
      "click": true,
      "touch": true,
      "value": true,
      "order": 1
    },
    "/input/grip": {
      "type": "trigger",
      "click": true,
      "touch": true,
      "value": true,
      "order": 2
    },
    "/input/trackpad": {
      "type": "trackpad",
      "click": true,
      "touch": true,
      "order": 3
    },
    "/input/joystick": {
      "type": "joystick",
      "click": true,
      "touch": true,
      "order": 4
    },
    "/input/application_menu": {
      "type": "button",
      "click": true,
      "order": 5
    },
    "/input/system": {
      "type": "button",
      "click": true,
      "order": 6
    },
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [ 50, 50 ]
    },
    "/output/haptic": {
      "type": "vibration",
      "binding_image_point": [ 50, 50 ]
    }
  },
  "default_bindings": [
    {
      "app_key": "openvr.component.vrcompositor",
      "binding_url": "vrcompositor_bindings_mouse.json"
    }
  ]
}
