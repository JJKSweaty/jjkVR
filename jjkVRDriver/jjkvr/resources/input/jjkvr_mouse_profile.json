{
  "jsonid" : "input_profile",
  "controller_type" : "jjkvr_mouse",
  "device_class" : "TrackedDeviceClass_Controller",
  "resource_root" : "jjkvr",
  "driver_name" : "jjkvr",
  "input_bindingui_mode" : "controller_handed",
  "should_show_binding_errors" : true,
  "input_bindingui_right" : {
    "image" : "{jjkvr}/icons/jjkvr_hmd.svg"
  },
  "input_source" : {
    "/input/trigger" : {
      "type" : "button",
      "click" : true,
      "order" : 1,
      "binding_image_point" : [ 180, 110 ]
    },
    "/input/grip" : {
      "type" : "button",
      "click" : true,
      "order" : 2,
      "binding_image_point" : [ 180, 110 ]
    },
    "/input/system" : {
      "type" : "button",
      "click" : true,
      "order" : 3,
      "binding_image_point" : [ 180, 110 ]
    },
    "/pose/raw" : {
      "type" : "pose",
      "binding_image_point" : [ 63, 148 ]
    }
  },
  "default_bindings" : [
    {
      "app_key" : "openvr.component.vrcompositor",
      "binding_url" : "vrcompositor_bindings_mouse.json"
    }
  ]
}
